{
    "latex-workshop.latex.rootFile": "${workspaceFolder}/main.tex",
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "/usr/local/texlive/2026basic/bin/universal-darwin/latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "latexmk",
    "latex-workshop.view.pdf.viewer": "tab"
}
